# Contact form delivery — configure ONE of the options below.
# With neither set, /api/contact returns 501 and the form tells visitors to
# email directly rather than silently discarding the message.

# Option 1 — POST the submission as JSON (Slack, Zapier, n8n, a CRM endpoint)
# CONTACT_WEBHOOK_URL=https://example.com/hooks/contact

# Option 2 — send an email through Resend
# RESEND_API_KEY=re_xxxxxxxxxxxx
# CONTACT_TO_EMAIL=hello@getgeoagent.com
# CONTACT_FROM_EMAIL=website@getgeoagent.com
